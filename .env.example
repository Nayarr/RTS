# Copier ce fichier en .env.local puis renseigner les valeurs.
#
# En local : valeurs affichées par `npx supabase status`
#   API_URL          -> VITE_SUPABASE_URL
#   PUBLISHABLE_KEY  -> VITE_SUPABASE_PUBLISHABLE_KEY
#
# Projet distant : Supabase > Project Settings > API Keys (clé « publishable »).
# Ces deux valeurs sont publiques (embarquées dans l'appli) : la sécurité repose sur le RLS.
# Ne JAMAIS mettre ici la clé « secret » / « service_role ».

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=

# Notifications push : clé publique VAPID (publique elle aussi).
# En local : valeur VAPID_PUBLIC_KEY de supabase/config.toml.
# Production : générée par `node scripts/vapid-keys.mjs` (la clé privée va dans les secrets Supabase).
# Laisser vide pour masquer l'activation des notifications.
VITE_VAPID_PUBLIC_KEY=
