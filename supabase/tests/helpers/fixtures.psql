-- Se connecter en tant qu'un utilisateur (claims JWT + rôle Postgres « authenticated »).
create or replace function pg_temp.act_as(p_user_id uuid)
returns void
language plpgsql
as $$
begin
  perform set_config('request.jwt.claims',
                     json_build_object('sub', p_user_id, 'role', 'authenticated')::text, true);
  execute 'set local role authenticated';
end;
$$;

-- Visiteur anonyme (client qui ouvre un lien public).
create or replace function pg_temp.act_as_anon()
returns void
language plpgsql
as $$
begin
  perform set_config('request.jwt.claims', json_build_object('role', 'anon')::text, true);
  execute 'set local role anon';
end;
$$;

-- Fichier fictif (normalement créé par l'Edge Function d'upload).
create or replace function pg_temp.fake_file(p_category public.file_category)
returns uuid
language sql
security definer
as $$
  insert into public.files (storage_key, category, mime_type, size_bytes)
  values ('test/' || gen_random_uuid(), p_category, 'image/jpeg', 1000)
  returning id;
$$;

grant execute on function pg_temp.act_as(uuid), pg_temp.act_as_anon(), pg_temp.fake_file(public.file_category)
  to authenticated, anon, service_role;
