# Ancienne application : conservée en local uniquement (référence), jamais versionnée
legacy/

# Dépendances et builds
node_modules/
dist/
dev-dist/
coverage/
*.tsbuildinfo

# Variables d'environnement : ne JAMAIS committer de secrets
.env
.env.*
!.env.example

# Supabase (fichiers locaux du CLI)
supabase/.branches/
supabase/.temp/
supabase/.env

# Tests end-to-end
playwright-report/
test-results/

# Éditeurs / système
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.log

# Outils locaux (aperçu Claude Code)
.claude/

# Lockfile Deno local (format non lu par l'edge runtime Supabase ; versions figées dans deno.json)
supabase/functions/**/deno.lock

# Reprise des forfaits de l’ancienne appli (données du client, généré par npm run import:forfaits)
forfaits-legacy.sql

# Reprise des clients et véhicules de GTA PRO (données du client, scripts/reprise/import-gta.py)
reprise-gta/
agent-eval-resultats.json
